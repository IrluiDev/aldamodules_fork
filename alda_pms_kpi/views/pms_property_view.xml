<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_property_kpi_section" model="ir.ui.view">
        <field name="name">pms.property.kpi.section</field>
        <field name="model">pms.property</field>
        <field name="inherit_id" ref="pms.pms_property_views_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="room_ids" invisible="1" />
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_open_kpis"
                    icon="fa-line-chart"
                    attrs="{'invisible': [('room_ids', '=', [])]}"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="kpi_count" nolabel="1" />
                            <span class="text-secondary fw-normal"> KPIs</span>
                        </span>
                        <span class="o_stat_value">
                            <field
                                name="occupancy_rate"
                                widget="percentage"
                                nolabel="1"
                            />
                            <span class="text-secondary fw-normal"> Occupation</span>
                        </span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="room_ids" invisible="1" />
                <header>
                        <button
                        name="%(action_pms_generate_batch_kpi)d"
                        string="View Property KPI's"
                        type="action"
                        class="btn-primary"
                        attrs="{'invisible': [('room_ids', '=', [])]}"
                    />
                </header>
            </xpath>

        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_pms_generate_batch_kpi_form" model="ir.ui.view">
        <field name="name">pms.wizard.generate.batch.kpi.form</field>
        <field name="model">pms.wizard.generate.batch.kpi</field>
        <field name="arch" type="xml">
            <form string="Generate KPIs multiple properties">
                <group>
                    <field name="date_start" />
                    <field name="date_end" />
                    <field
                        name="property_ids"
                        widget="many2many_tags"
                        options="{'no_create': True}"
                    />
                </group>
                <footer>
                    <button
                        string="Views "
                        type="object"
                        name="action_generate_kpis"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pms_generate_batch_kpi" model="ir.actions.act_window">
        <field name="name">Generar KPIs</field>
        <field name="res_model">pms.wizard.generate.batch.kpi</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pms_generate_batch_kpi_form" />
        <field name="target">new</field>
    </record>
</odoo>

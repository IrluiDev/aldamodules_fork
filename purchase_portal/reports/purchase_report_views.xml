<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_order_search" model="ir.ui.view">
        <field name="name">report.purchase.order.search</field>
        <field name="model">purchase.report</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_partner_id']" position="after">
                <filter string="Commercial Vendor" name="group_commercial_partner_id" context="{'group_by':'commercial_partner_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>

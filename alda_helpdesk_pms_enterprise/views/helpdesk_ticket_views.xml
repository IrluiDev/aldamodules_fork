<?xml version="1.0" encoding="utf-8" ?>
<odoo>

        <record id="pms_helpdesk_ticket_view_form" model="ir.ui.view">
            <field name="name">helpdesk.ticket.form.inherit.pms</field>
            <field name="model">helpdesk.ticket</field>
            <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='priority']" position="before">
                    <field
                    name="pms_property_id"
                    options="{'no_open': True,'no_create': True}"
                />
                    <field
                    name="pms_room_id"
                    options="{'no_open': True,'no_create': True}"
                    attrs="{'invisible': [('pms_property_id', '=', False)]}"
                />
                </xpath>
            </field>
        </record>

    <!-- Vista tree -->
    <record id="pms_helpdesk_ticket_view_tree" model="ir.ui.view">
        <field name="name">helpdesk.ticket.tree.inherit.pms</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="pms_property_id" />
                <field name="pms_room_id" />
            </xpath>
        </field>
    </record>

    <!-- Vista kanban -->
    <record id="pms_helpdesk_ticket_view_kanban" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban.inherit.pms</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ticket_type_id']" position="after">
                <div
                    class="o_property_info"
                    style="display: flex; align-items: center; gap: 8px; margin: 2px 0;"
                >
                    <span title="Property">
                        <i class="fa fa-building-o" />
                        <span class="sr-only">Property</span>
                    </span>
                    <field name="pms_property_id" class="ml-2" />
                </div>
                <div
                    class="o_property_info"
                    style="display: flex; align-items: center; gap: 8px; margin: 2px 0;"
                >
                    <span title="Room">
                        <i class="fa fa-bed" />
                        <span class="sr-only">Room</span>
                    </span>
                    <field name="pms_room_id" class="ml-2" />
                </div>
            </xpath>
        </field>
    </record>

    <!-- Vista graph -->
    <record id="pms_helpdesk_ticket_view_graph" model="ir.ui.view">
        <field name="name">helpdesk.ticket.graph.inherit.pms</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_graph_main" />
        <field name="arch" type="xml">
            <xpath expr="//graph" position="inside">
                <field name="pms_property_id" />
            </xpath>
        </field>
    </record>

    <!-- Vista pivot -->
    <record id="pms_helpdesk_ticket_view_pivot" model="ir.ui.view">
        <field name="name">helpdesk.ticket.pivot.inherit.pms</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_pivot_main" />
        <field name="arch" type="xml">
            <xpath expr="//pivot" position="inside">
                <field name="pms_property_id" />
                <field name="pms_room_id" />
            </xpath>
        </field>
    </record>

    <!-- Vista search -->
    <record id="pms_helpdesk_ticket_search_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search.inherit.pms</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="pms_property_id" />
                <field name="pms_room_id" />
            </xpath>
            <xpath expr="//group" position="inside">
                <filter
                    string="Property"
                    name="group_property"
                    context="{'group_by': 'pms_property_id'}"
                />
                <filter
                    string="Room"
                    name="group_room"
                    context="{'group_by': 'pms_room_id'}"
                />
            </xpath>


            <xpath expr="//filter[@name='my_ticket']" position="after">
                <filter
                    string="Property"
                    name="filter_hotel_assigned"
                    domain="[('pms_property_id','!=',False)]"
                />
                <filter
                    string="No Property"
                    name="filter_hotel_unassigned"
                    domain="[('pms_property_id','=',False)]"
                />
                <filter
                    string="Room"
                    name="room_id"
                    domain="[('pms_room_id','!=',False)]"
                />
            </xpath>
        </field>
    </record>

</odoo>
